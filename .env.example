# Copy to .env and fill in. Never commit the real .env file.

# LLM providers — src/chat/llm.py builds a fallback chain from whichever of
# these are set, in this priority: Vertex Gemini -> NVIDIA NIM -> Anthropic.
# Set just one for a single-provider setup, or several for automatic fallback.

# -- Google Gemini, direct API (Google AI Studio key) — simplest option, no
#    GCP project/service-account needed. Preferred over Vertex below if set.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# -- Google Gemini via Vertex AI (only used if GEMINI_API_KEY is unset) --
# Auth via a service account json (path in GOOGLE_APPLICATION_CREDENTIALS) or
# `gcloud auth application-default login`.
VERTEX_PROJECT=
VERTEX_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=

# -- NVIDIA NIM (OpenAI-compatible) — used as fallback --
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL=meta/llama-3.1-8b-instruct

# -- Anthropic --
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-sonnet-4-5
VISION_OCR_MODEL=claude-sonnet-4-5
# Max output tokens for one scanned-page OCR call. Dense pages (many small
# text elements) can exceed this and get truncated/salvaged — see README.
VISION_OCR_MAX_TOKENS=8192

# Delta engine thresholds
DELTA_MATCH_THRESHOLD=0.72
DELTA_MIN_CONFIDENCE=0.5

# Observability
TRACE_DIR=./traces
LOG_LEVEL=INFO
